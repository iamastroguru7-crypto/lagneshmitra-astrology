<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LM 3.0 Humanizer Engine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; padding: 20px; }
        .container { max-width: 800px; background: white; padding: 30px; border-radius: 15px; box-shadow: 0px 5px 15px rgba(0,0,0,0.1); }
        textarea { height: 200px; width: 100%; margin: 15px 0; padding: 10px; border-radius: 8px; border: 1px solid #ddd; }
        .btn-custom { background: #007bff; color: white; }
    </style>
</head>
<body>

<div class="container">
    <h2 class="text-center">LM 3.0 Humanizer Engine</h2>
    
    <textarea id="inputText" placeholder="Paste your AI content here..."></textarea>
    
    <div class="d-flex justify-content-between align-items-center my-3">
        <span id="aiScore" class="fw-bold">AI Score: --%</span>
        <div>
            <button class="btn btn-secondary" onclick="analyzeText()">Analyze</button>
            <button id="humanizeBtn" class="btn btn-primary" onclick="humanizeContent()" disabled>Humanise</button>
        </div>
    </div>

    <textarea id="outputText" readonly placeholder="Humanised content will appear here..."></textarea>
    <button class="btn btn-success w-100 mt-2" onclick="exportText()">Export as .txt</button>
</div>

<script>
    function analyzeText() {
        const text = document.getElementById("inputText").value;
        const aiIndicators = ['delve', 'comprehensive', 'furthermore', 'tapestry', 'in conclusion'];
        let count = 0;
        aiIndicators.forEach(word => { if(text.toLowerCase().includes(word)) count += 25; });
        document.getElementById("aiScore").innerText = `AI Score: ${Math.min(count, 99)}%`;
        document.getElementById("humanizeBtn").disabled = false;
    }

    async function humanizeContent() {
        const rawText = document.getElementById("inputText").value;
        alert("Processing with GSK API..."); // Backend link yahan aayega
        
        // Yahan tumhara Vercel backend URL aayega
        const response = await fetch('YOUR_VERCEL_BACKEND_URL/humanize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: rawText })
        });
        
        const data = await response.json();
        document.getElementById("outputText").value = data.humanized_text;
    }

    function exportText() {
        const text = document.getElementById("outputText").value;
        const blob = new Blob([text], { type: 'text/plain' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'humanised_content.txt';
        a.click();
    }
</script>
</body>
</html>
      
